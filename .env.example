# 운영자(신고 처리) 비밀번호. 비워두면 운영자 기능 꺼짐
ADMIN_PASSWORD=
# 네이버 클라우드 플랫폼 Maps Application 의 Client ID (필수)
NAVER_MAP_CLIENT_ID=
# 구글 로그인: Google Cloud OAuth "웹 애플리케이션" 클라이언트 ID (공개 값)
GOOGLE_CLIENT_ID=
# 쿠키 서명·익명 사용자 구분용 임의의 긴 문자열 (필수 권장, 바꾸면 신고 중복 판별이 초기화됨)
SESSION_SECRET=
# PostgreSQL 접속 주소 (Neon 무료 DB). 없으면 data/toilets.json 파일에 저장
DATABASE_URL=
PORT=3000
# 데이터 파일 위치 (기본: ./data/toilets.json)
# DATA_FILE=/app/data/toilets.json
